#!/bin/sh
#
# Auto-build Vite asseta kad su frontend izvori u commitu.
# Produkcioni server nema Node.js, pa public/build MORA da bude commitovan
# i usklađen sa izvorom (vidi memoriju: spa-deploy-cpanel).
#
# Preskoči jednokratno sa:  git commit --no-verify

# -z je obavezno: bez njega git navodnicima escapuje ne-ASCII putanje, pa se
# ⚡ page komponente pojave kao "resources/..." i ne uhvati ih grep ispod.
staged=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n')

# Da li commit dira nešto što utiče na build (JS/CSS/Blade/config)?
if printf '%s\n' "$staged" | grep -Eq '^(resources/|package(-lock)?\.json$|vite\.config\.)'; then
    echo "pre-commit: frontend izvori promenjeni → pokrećem 'npm run build'…"

    out=$(npm run build 2>&1)
    if [ $? -ne 0 ]; then
        echo "$out" >&2
        echo "" >&2
        echo "pre-commit: BUILD NEUSPEO — commit prekinut." >&2
        echo "Popravi grešku pa ponovo, ili preskoči sa: git commit --no-verify" >&2
        exit 1
    fi

    git add -A public/build

    if ! git diff --cached --quiet -- public/build; then
        echo "pre-commit: public/build osvežen i dodat u commit."
    fi
fi

exit 0
